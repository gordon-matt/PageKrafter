<Project>

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<Version>1.0.1</Version>
		<Authors>Matt Gordon</Authors>
		<Company>Matt Gordon</Company>
		<Product>PageKrafter</Product>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>blazor;page-builder;email-builder;cms;drag-and-drop</PackageTags>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/gordon-matt/PageKrafter</PackageProjectUrl>
		<RepositoryUrl>https://github.com/gordon-matt/PageKrafter</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<!-- Packed into every package. Projects that are not packed (demo, samples, tests) never use these. -->
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)_Misc\Icon.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
